# Security Headers for Netlify
/*
  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com; frame-src 'self' https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';
  
  # XSS Protection
  X-XSS-Protection: 1; mode=block
  
  # Content Type Options
  X-Content-Type-Options: nosniff
  
  # Frame Options
  X-Frame-Options: DENY
  
  # Referrer Policy
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Permissions Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  
  # Strict Transport Security (HTTPS only)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # Cache Control for static assets
  Cache-Control: public, max-age=3600, must-revalidate

# Specific headers for HTML files
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  
# Specific headers for CSS files
/*.css
  Cache-Control: public, max-age=3600, must-revalidate
  
# Specific headers for JS files
/*.js
  Cache-Control: public, max-age=3600, must-revalidate
  
# Specific headers for images
/*.jpg
  Cache-Control: public, max-age=86400, must-revalidate
  
/*.png
  Cache-Control: public, max-age=86400, must-revalidate
  
/*.gif
  Cache-Control: public, max-age=86400, must-revalidate
  
/*.svg
  Cache-Control: public, max-age=86400, must-revalidate
  
/*.webp
  Cache-Control: public, max-age=86400, must-revalidate

# Specific headers for video files
/*.mp4
  Cache-Control: public, max-age=86400, must-revalidate

# Service Worker
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Manifest
/manifest.json
  Cache-Control: public, max-age=86400
